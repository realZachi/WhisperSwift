#!/bin/bash
# Pre-commit hook: Check for code duplicates before committing
# This runs automatically before each commit

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${YELLOW}Running pre-commit checks...${NC}"

# Check if any Swift files are staged
STAGED_SWIFT_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.swift$' || true)

if [ -z "$STAGED_SWIFT_FILES" ]; then
    echo -e "${GREEN}No Swift files staged, skipping duplicate check.${NC}"
    exit 0
fi

echo "Checking for code duplicates in staged Swift files..."

# Check if jscpd is installed
if ! command -v jscpd &> /dev/null; then
    echo -e "${YELLOW}jscpd not found. Installing...${NC}"
    npm install -g jscpd
fi

# Run duplicate detection
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Create temp directory for reports
TEMP_DIR=$(mktemp -d)
trap "rm -rf $TEMP_DIR" EXIT

# Run jscpd with threshold check
if jscpd --config "$SCRIPT_DIR/.jscpd.json" "$SCRIPT_DIR" --output "$TEMP_DIR" --exitCode 2>/dev/null; then
    echo -e "${GREEN}Duplicate check passed.${NC}"
else
    echo -e "${RED}================================================${NC}"
    echo -e "${RED}  Code duplication exceeds threshold!${NC}"
    echo -e "${RED}================================================${NC}"
    echo ""
    echo "Run './scripts/check-duplicates.sh' for detailed report."
    echo ""
    echo -e "${YELLOW}To bypass this check (not recommended):${NC}"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo -e "${GREEN}Pre-commit checks passed.${NC}"
